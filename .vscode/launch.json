            "program": "${workspaceFolder}/target/debug/wit-bindgen.exe",
            "args": [
                "csharp",
                ".\\tests\\codegen\\import-and-export-resource.wit",
                "--world",
                "%resources",
                "--out-dir",
                ".\\target\\artifacts\\codegen\\csharp\\import-and-export-resource.wit\\bindings",
                "--runtime=native-aot",
                "--generate-stub"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "preLaunchTask": "cargo build"
